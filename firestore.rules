rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A customer may access only their own profile document.
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validProfileFields() {
        return request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 100
          && request.resource.data.gender is string
          && request.resource.data.dateOfBirth is timestamp
          && request.resource.data.age is int
          && request.resource.data.age >= 18
          && request.resource.data.age <= 120
          && request.resource.data.phoneNumber is string
          && request.resource.data.phoneNumber == request.auth.token.phone_number
          && request.resource.data.email is string
          && request.resource.data.photoUrl is string
          && request.resource.data.role == 'customer'
          && request.resource.data.profileCompleted == true
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt == request.time;
      }

      // New profile documents may contain only the fields managed by this website.
      function validNewProfile() {
        return request.resource.data.keys().hasOnly([
          'uid', 'name', 'gender', 'dateOfBirth', 'age', 'phoneNumber',
          'email', 'photoUrl', 'role', 'profileCompleted', 'createdAt', 'updatedAt'
        ]) && validProfileFields();
      }

      // Preserve any existing shared-schema fields that this website does not change.
      function validProfileUpdate() {
        // Once createdAt is a valid Timestamp, the customer cannot rewrite it.
        // A missing or malformed legacy value may be repaired to a Timestamp.
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid', 'name', 'gender', 'dateOfBirth', 'age', 'phoneNumber',
          'email', 'photoUrl', 'role', 'profileCompleted', 'createdAt', 'updatedAt'
        ])
          && (
            !(resource.data.createdAt is timestamp)
            || request.resource.data.createdAt == resource.data.createdAt
          )
          && validProfileFields();
      }

      allow read: if isOwner();
      allow create: if isOwner() && validNewProfile();
      allow update: if isOwner() && validProfileUpdate();
      allow delete: if false;
    }

    // Deny access to every collection until its rules are explicitly designed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
